{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/node:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": ["apps/api/src/assets"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig apps/api/tsconfig.app.json --watch apps/api/src/main.ts",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "production": {
          "command": "node dist/apps/api/main.js"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/api && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts"
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/api && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate src/migrations/Migration"
      }
    }
  },
  "tags": []
}

