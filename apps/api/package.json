{
  "name": "api",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate src/migrations/Migration",
    "seed:drivers": "tsx src/scripts/seed-drivers.ts"
  },
  "dependencies": {
    "@waka/shared": "*",
    "@faker-js/faker": "^9.0.0",
    "@nestjs/websockets": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "socket.io": "^4.7.2"
  }
}

