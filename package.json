{
  "name": "@findwaka/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:api\" \"yarn dev:web\" \"yarn dev:mobile\"",
    "dev:api": "cd apps/api && yarn start:dev",
    "api:dev": "cd apps/api && yarn start:dev",
    "api:migrate": "cd apps/api && yarn migration:run",
    "api:migration:generate": "cd apps/api && yarn migration:generate",
    "dev:web": "cd apps/web && yarn dev",
    "dev:mobile": "cd apps/mobile && npx expo start --clear",
    "build:shared": "cd packages/shared && yarn build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-config": "~54.0.9",
    "@expo/metro-runtime": "~6.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.0",
    "expo-location": "^19.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "nativewind": "4.1.23",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.0",
    "react-router-dom": "6.29.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tailwindcss": "^3.3.2",
    "typeorm": "^0.3.28",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@expo/cli": "~54.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^4.0.0",
    "autoprefixer": "^10.4.23",
    "babel-preset-expo": "~54.0.7",
    "concurrently": "^9.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest-expo": "^54.0.16",
    "jiti": "2.4.2",
